# ==============================================================================
# NEXUS POS PRO — TEMPLATE DES VARIABLES D'ENVIRONNEMENT (v1.2.30)
# ==============================================================================
# Copiez ce fichier sous le nom '.env' à la racine du projet et complétez les valeurs :
#   cp .env.example .env

# ------------------------------------------------------------------------------
# 1. Configuration Supabase Cloud (Obligatoire)
# ------------------------------------------------------------------------------
# URL de l'instance Supabase (Projet: unlwfvldqxfccgrrgbwf, région: eu-central-1)
VITE_SUPABASE_URL=https://unlwfvldqxfccgrrgbwf.supabase.co
# Clé API anonyme publique (anon key)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 2. Identifiants Propriétaire / Super-Admin (Obligatoire)
# ------------------------------------------------------------------------------
# Email principal du propriétaire / gérant du magasin (accès maître)
VITE_OWNER_EMAIL=owner@nexuspos.dz
# UUID d'authentification Supabase du propriétaire
VITE_OWNER_UID=00000000-0000-0000-0000-000000000000
# Email de l'administrateur secondaire (optionnel)
VITE_ADMIN_EMAIL=admin@nexuspos.dz

# ------------------------------------------------------------------------------
# 3. Réseau & Serveur Backend (Local / Production)
# ------------------------------------------------------------------------------
# Port d'écoute du serveur Node / Express (défaut: 3000)
PORT=3000
# Environnement d'exécution : 'development' ou 'production'
NODE_ENV=development
# URL de base de l'application (utilisé pour affichage client et API)
VITE_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. Intelligence Artificielle & Vision Factures (Optionnel / IA Studio)
# ------------------------------------------------------------------------------
# Clé API Google Gemini (Vision de factures, extraction JSON, assistant)
VITE_GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_KEY=your-gemini-api-key

# Clé API Groq Vision (Alternative ultra-rapide Llama Vision pour factures)
VITE_GROQ_API_KEY=your-groq-api-key

# ------------------------------------------------------------------------------
# 5. Monitoring d'Erreurs Sentry (Optionnel / Télémétrie de Caisse)
# ------------------------------------------------------------------------------
# DSN Sentry (ex: https://abc123xyz@o123456.ingest.sentry.io/78910)
# Laisser vide pour désactiver le reporting distant Sentry
VITE_SENTRY_DSN=
