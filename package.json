{
  "name": "nexus-pos-pro",
  "description": "Système de Caisse et Gestion Commerciale Professionnelle Offline-First",
  "author": "Nexus POS Pro Team",
  "private": true,
  "version": "1.2.57",
  "main": "electron/main.js",
  "scripts": {
    "start": "node dist/server.cjs",
    "dev": "tsx server.ts",
    "dev:vite": "vite",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "tsx scripts/test-live-supabase.ts",
    "electron": "electron .",
    "bump:version": "node scripts/bump-version.cjs",
    "build:icon": "node create-ico.js",
    "dist": "npm run build:icon && npm run build && electron-builder --win --x64",
    "electron:build": "npm run build:icon && npm run build && electron-builder --win --x64",
    "electron:dist": "npm run build:icon && npm run build && electron-builder --win --x64",
    "android:build": "npm run build && npx cap sync && npx cap open android",
    "android:apk": "npm run build && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.5.1",
    "@google/genai": "^2.17.1",
    "@sentry/react": "^11.8.0",
    "@supabase/supabase-js": "^2.107.0",
    "@zxing/library": "^0.23.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "papaparse": "^5.5.3",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-barcode": "^1.6.1",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-to-print": "^3.3.0",
    "react-window": "^2.2.7",
    "recharts": "^2.15.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-legacy": "^6.1.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.3",
    "electron": "^42.7.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "source-map": "^0.8.0-beta.0",
    "tailwindcss": "^4.1.14",
    "terser": "^5.48.0",
    "tsx": "^4.21.0",
    "tus-js-client": "^4.3.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.9",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "qs": "^6.16.0",
    "axios": "^1.20.0",
    "serialize-javascript": "^7.1.2",
    "esbuild": "^0.28.2",
    "shell-quote": "^1.12.0",
    "proxy-addr": "^2.0.8",
    "source-map-js": "^1.2.2"
  },
  "build": {
    "appId": "com.nexus.pos.pro",
    "productName": "Nexus POS Pro",
    "copyright": "Copyright © 2024 Nexus POS",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "!node_modules/.cache"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "portable": {
      "artifactName": "NexusPOSPro-${version}-Portable.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "NexusPOSPro-${version}-Setup.exe",
      "differentialPackage": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nexus POS Pro",
      "runAfterFinish": true
    },
    "extraResources": [
      {
        "from": "dist/",
        "to": "dist/",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
